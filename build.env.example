# build.env — tool locations for build-all.sh, tools/ocaml-refrun.sh and the research scripts.
# Copy to build.env (gitignored) and fill in, or export the same variables in your shell.
# Nothing is guessed: a step whose tool is unset stops and names the variable.

# wasi-sdk 22 install root (bin/clang, share/wasi-sysroot)
#   https://github.com/WebAssembly/wasi-sdk/releases/tag/wasi-sdk-22
WASI_SDK=/opt/wasi-sdk-22.0

# binaryen install root (bin/wasm-merge, bin/wasm-opt), v124 or later
#   https://github.com/WebAssembly/binaryen/releases
BINARYEN=/opt/binaryen

# the WasmFX-merged reference interpreter binary (clone, then `make` in interpreter/)
#   https://github.com/wasmfx/specfx
WASM_INTERP=/path/to/specfx/interpreter/wasm

# wasm_of_ocaml.exe from a js_of_ocaml *master* build (emits try_table and supports
# --effects=native; see CLAUDE.md, "js_of_ocaml caveat")
WASM_OF_OCAML=/path/to/js_of_ocaml/_build/default/compiler/bin-wasm_of_ocaml/wasm_of_ocaml.exe

# optional
#V3C=v3c                 # Virgil compiler, for Wizard (default: v3c on PATH)
#RUST_TOOLCHAIN=1.98.0   # rustup toolchain for wasmtime (installed if absent)
