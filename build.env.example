# build.env — optional overrides for env.sh.  Copy to build.env (gitignored) and uncomment a
# line to use a tool installed elsewhere instead of the copy under dependencies/; build-all.sh
# then skips building that dependency.  With everything commented out, dependencies/ is used.

#WASI_SDK=/opt/wasi-sdk-22.0                # install root: bin/clang, share/wasi-sysroot
#BINARYEN=/opt/binaryen                     # build/install root: bin/wasm-merge, bin/wasm-opt (>= v124)
#WASM_INTERP=/path/to/specfx/interpreter/wasm
#WASM_OF_OCAML_EXE=/path/to/js_of_ocaml/_build/default/compiler/bin-wasm_of_ocaml/wasm_of_ocaml.exe
#OCAML_SWITCH=default                       # an existing opam switch (name or directory): OCaml 5,
#                                           # dune, menhir, ppxlib, sedlex, cmdliner, yojson, ocamlfind
#VIRGIL_LOC=/path/to/virgil                 # V3C defaults to $VIRGIL_LOC/bin/v3c
#WIZENG=/path/to/wizeng.x86-64-linux
#WASMTIME=/path/to/wasmtime
#RUST_TOOLCHAIN=1.98.0
