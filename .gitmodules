[submodule "benches"]
	path = benchmark/benches
	url = https://github.com/ocaml-bench/benches.git
[submodule "macro-benches"]
	path = benchmark/macro-benches
	url = https://github.com/ocaml-bench/macro-benches.git
[submodule "angstrom"]
	path = benchmark/angstrom
	url = https://github.com/inhabitedtype/angstrom.git
[submodule "fiber-c"]
	path = benchmark/fiber-c
	url = https://github.com/wasmfx/fiber-c.git
[submodule "wizard-engine"]
	path = dependencies/wizard-engine
	url = https://github.com/titzer/wizard-engine.git
[submodule "wasmtime"]
	path = dependencies/wasmtime
	url = https://github.com/bytecodealliance/wasmtime.git
[submodule "dependencies/virgil"]
	path = dependencies/virgil
	url = https://github.com/titzer/virgil.git
[submodule "dependencies/specfx"]
	path = dependencies/specfx
	url = https://github.com/wasmfx/specfx.git
[submodule "dependencies/binaryen"]
	path = dependencies/binaryen
	url = https://github.com/WebAssembly/binaryen.git
[submodule "dependencies/js_of_ocaml"]
	path = dependencies/js_of_ocaml
	url = https://github.com/ocsigen/js_of_ocaml.git
